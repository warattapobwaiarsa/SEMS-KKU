# ==============================================================================
# SEMS Local Environment Variables Example
# Duplicate this file as '.env' for local configuration.
# DO NOT commit the actual '.env' file containing real secrets to GitHub!
# ==============================================================================

# PostgreSQL Database Configuration (used by docker-compose.yml)
DB_USER=sems_user
DB_PASSWORD=sems_password
DB_NAME=sems_db
DB_PORT=5432

# Prisma Database Connection URL (used by Backend / Prisma ORM)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public"

# Application Ports
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Security & PDPA (Placeholders for local development)
JWT_SECRET=super_secret_jwt_key_for_development_only
AES_CITIZEN_ID_KEY=32_bytes_hex_or_base64_encryption_key_for_dev_test
